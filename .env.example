# --- Base de donnees (obligatoire) -------------------------------------------
# Postgres. Sur Neon, utilisez la chaine "Pooled connection".
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/basededonnees?sslmode=require

# --- Google Sheets (optionnel) -----------------------------------------------
# Sans ces valeurs l'application fonctionne : les transmissions sont
# enregistrees en base et la recopie vers la feuille reste en attente.
GOOGLE_SHEET_ID=
# En local : chemin vers le fichier de cle. En production : collez le JSON complet.
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
GOOGLE_SHEET_TAB=Transmissions

# --- Divers ------------------------------------------------------------------
SESSION_TTL_DAYS=30
# Jeton protegeant la tache d'entretien. Generez-le avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
